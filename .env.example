# Only public Remotive, Remote OK, Arbeitnow are enabled by default.
# Copy to .env.local. Never use NEXT_PUBLIC_ for these credentials.
# Persistent directory required. Use ONE Node process / replica.
DATA_DIR=.data
MUSE_API_KEY=
GREENHOUSE_BOARDS=
LEVER_BOARDS=
ASHBY_BOARDS=
SMARTRECRUITERS_BOARDS=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb
FEED_KEYWORDS=developer
JOOBLE_ENABLED=false
JOOBLE_API_KEY=
JOOBLE_LOCATION=United States
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# ReliefWeb requires your own pre-approved appname (mandatory since Nov 2025).
RELIEFWEB_APPNAME=
# Optional ISO alpha-3 country; ETH focuses this feed on Ethiopia.
RELIEFWEB_COUNTRY=ETH
REED_API_KEY=
