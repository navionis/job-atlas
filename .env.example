# Public feeds (Remotive, Remote OK, Arbeitnow, Cryptocurrency Jobs,
# Web3.career, Jump Crypto Network, RareTalent, FindWeb3, SailOnchain)
# are enabled by default. Copy to .env.local.
# Never use NEXT_PUBLIC_ for these credentials.

# PostgreSQL storage for feed state and collected jobs.
# When set, state hydrates from Postgres and jobs persist to the jobs table.
# When unset, state falls back to the JSON file below.
DATABASE_URL=postgres://user:password@localhost:5432/jobatlas
# Set true for hosted Postgres that requires SSL.
DATABASE_SSL=false

# File fallback directory. Persistent directory required. ONE Node process / replica.
DATA_DIR=.data
MUSE_API_KEY=
GREENHOUSE_BOARDS=
LEVER_BOARDS=
ASHBY_BOARDS=
SMARTRECRUITERS_BOARDS=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb
FEED_KEYWORDS=developer
JOOBLE_ENABLED=false
JOOBLE_API_KEY=
JOOBLE_LOCATION=United States
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# ReliefWeb requires your own pre-approved appname (mandatory since Nov 2025).
RELIEFWEB_APPNAME=
# Optional ISO alpha-3 country code to focus this feed; leave empty for global.
RELIEFWEB_COUNTRY=
REED_API_KEY=

# Google sign-in. Auth is disabled while GOOGLE_CLIENT_ID is empty.
# Create an OAuth client (Web application) in Google Cloud Console and add
# <your-origin>/api/auth/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random string used to sign the session cookie.
AUTH_SECRET=
# Canonical site origin for OAuth redirects (must match the registered
# redirect URI's host). Leave empty to derive it from the request.
APP_ORIGIN=

# Devin API — AI keyword extraction for uploaded resumes.
# Get a key in the Devin web app: Settings → Devin API.
# Without a key, uploads fall back to the built-in local extractor.
DEVIN_API_KEY=
# Optional: organization id routes sessions through the v3 API.
DEVIN_ORG_ID=
# Optional: override the API base URL (defaults to https://api.devin.ai).
DEVIN_API_URL=
