# Public feeds (Remotive, Remote OK, Arbeitnow, Cryptocurrency Jobs,
# Web3.career, Jump Crypto Network, RareTalent, FindWeb3, SailOnchain)
# are enabled by default. Copy to .env.local.
# Never use NEXT_PUBLIC_ for these credentials.

# PostgreSQL storage for feed state and collected jobs.
# When set, state hydrates from Postgres and jobs persist to the jobs table.
# When unset, state falls back to the JSON file below.
DATABASE_URL=postgres://user:password@localhost:5432/jobatlas
# Set true for hosted Postgres that requires SSL.
DATABASE_SSL=false

# File fallback directory. Persistent directory required. ONE Node process / replica.
DATA_DIR=.data
MUSE_API_KEY=
GREENHOUSE_BOARDS=
LEVER_BOARDS=
ASHBY_BOARDS=
SMARTRECRUITERS_BOARDS=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb
FEED_KEYWORDS=developer
JOOBLE_ENABLED=false
JOOBLE_API_KEY=
JOOBLE_LOCATION=United States
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# ReliefWeb requires your own pre-approved appname (mandatory since Nov 2025).
RELIEFWEB_APPNAME=
# Optional ISO alpha-3 country code to focus this feed; leave empty for global.
RELIEFWEB_COUNTRY=
REED_API_KEY=

# Google sign-in. Auth is disabled while GOOGLE_CLIENT_ID is empty.
# Create an OAuth client (Web application) in Google Cloud Console and add
# <your-origin>/api/auth/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random string used to sign the session cookie.
AUTH_SECRET=
# Bump this value to invalidate every outstanding session at once.
SESSION_EPOCH=1
# Canonical site origin for OAuth redirects (must match the registered
# redirect URI's host). SET THIS IN PRODUCTION — when empty the origin is
# derived from request headers, which requires the APP_HOSTS guard below.
APP_ORIGIN=
# Comma-separated Host header allowlist, used only when APP_ORIGIN is empty.
# An untrusted Host falls back to the first listed origin instead of being
# echoed into OAuth redirects. Example: APP_HOSTS=atlas.example.com
APP_HOSTS=
# Comma-separated Google account emails allowed to open /admin and toggle
# feeds. Empty = every signed-in user is treated as admin.
ADMIN_EMAILS=

# SMTP for passwordless email sign-in (magic links). Works with any SMTP
# provider — e.g. Gmail + an App Password (host smtp.gmail.com, port 587,
# user you@gmail.com, pass <16-char app password>).
# When SMTP_HOST is empty, sign-in links are printed to the server console
# instead of emailed — handy for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Display sender; defaults to SMTP_USER when empty.
SMTP_FROM=

# Resume keyword extraction uses the built-in local extractor.
